# Copy to .env.local and fill in. Generate secrets with: openssl rand -base64 32

# MongoDB (used by the app, the sync worker and the seed script)
MONGODB_URI=mongodb://127.0.0.1:27017/splunkevents
# Days to keep synced runs before MongoDB deletes them (set before the first sync).
RUN_RETENTION_DAYS=90

# Login (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Password for the demo users that `npm run seed` creates (8+ characters).
DEMO_PASSWORD=
# Hosted demo with dummy data only: "true" lists the demo accounts on the login
# page with one-click sign-in and shows DEMO_PASSWORD there.
DEMO_MODE=

# Sync worker. fixture loads the dummy reports; live calls the Splunk REST API.
SPLUNK_MODE=fixture
# Live mode only. Keep the token out of the web app's environment.
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
# Or the path of a file that holds the token, such as a mounted secret.
SPLUNK_TOKEN_FILE=
# The search head's timezone, used for schedule text and run counts.
SPLUNK_TZ=UTC
SYNC_INTERVAL_MINUTES=15

# The worker tells the app to refresh its cached data after each sync.
APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# Optional: PostHog project API key (US cloud) for usage analytics.
NEXT_PUBLIC_POSTHOG_KEY=

# Ask AI (docs/ai.md). Without a key the AI page says AI answers are off; the
# rest of the app works as before. Get a key at https://aistudio.google.com/apikey.
# A project without billing uses the free tier: no cost, but Google may use the
# prompts to improve its products, so use it with dummy data only.
GEMINI_API_KEY=
# Default gemini-3.8-flash. Cheaper: gemini-3.1-flash-lite.
AI_MODEL=
# Default gemini-embedding-2: turns searches into vectors, so Write SPL can find the
# examples most like a request (docs/ai.md). gemini-embedding-001 also works.
AI_EMBEDDING_MODEL=
# "fake" answers with canned text and needs no key (for trying the pages).
AI_PROVIDER=
# "false" turns AI answers off, even with a key.
AI_ENABLED=
# AI requests per account per day (UTC), and for everyone together.
AI_DAILY_LIMIT=50
AI_SITE_DAILY_LIMIT=1000
# With SPLUNK_MODE=live, AI answers stay off until this is "true", because they
# send report data to Google. Set it only once your company has approved that.
AI_ALLOW_LIVE_DATA=
# Optional: Splunk Web's address (e.g. https://splunk.example.com/en-US), for
# "Open in Splunk" on searches from Write SPL.
SPLUNK_WEB_URL=
