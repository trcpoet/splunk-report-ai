# Copy to .env.local and fill in. Generate secrets with: openssl rand -base64 32

# MongoDB (used by the app, the sync worker and the seed script)
MONGODB_URI=mongodb://127.0.0.1:27017/splunkevents
# Days to keep synced runs before MongoDB deletes them (set before the first sync).
RUN_RETENTION_DAYS=90

# Login (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Password for the demo users that `npm run seed` creates (8+ characters).
DEMO_PASSWORD=
# Hosted demo with dummy data only: "true" lists the demo accounts on the login
# page with one-click sign-in and shows DEMO_PASSWORD there.
DEMO_MODE=

# Sync worker. fixture loads the dummy reports; live calls the Splunk REST API.
SPLUNK_MODE=fixture
# Live mode only. Keep the token out of the web app's environment.
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
# The search head's timezone, used for schedule text and run counts.
SPLUNK_TZ=UTC
SYNC_INTERVAL_MINUTES=15

# The worker tells the app to refresh its cached data after each sync.
APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# Optional: PostHog project API key (US cloud) for usage analytics.
NEXT_PUBLIC_POSTHOG_KEY=
