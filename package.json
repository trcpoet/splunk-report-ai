{
  "name": "splunk-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "node --env-file-if-exists=.env.local --import tsx worker/sync.ts",
    "sync:watch": "node --env-file-if-exists=.env.local --import tsx worker/sync.ts --watch",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo-users.ts",
    "test": "node --env-file-if-exists=.env.local --import tsx --test \"lib/**/*.test.ts\"",
    "ml": "ml/.venv/bin/python ml/score.py",
    "ml:plot": "ml/.venv/bin/python ml/score.py --plot",
    "test:ml": "ml/.venv/bin/python -m pytest ml",
    "eval:spl": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/eval-spl.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "@google/genai": "^2.31.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.32.0",
    "lucide-react": "^1.8.0",
    "mongodb": "~6.20.0",
    "mongoose": "^8.24.5",
    "next": "16.4.2",
    "ogl": "^1.0.11",
    "posthog-js": "^1.435.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
