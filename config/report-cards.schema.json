              {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A column of the report's results, spelled exactly as in its search's last step."
                  },
                  "atMost": {
                    "type": "number"
                  }
                },
                "required": [
                  "column",
                  "atMost"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A column of the report's results, spelled exactly as in its search's last step."
                  },
                  "equals": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "required": [
                  "column",
                  "equals"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "results": {
                    "type": "object",
